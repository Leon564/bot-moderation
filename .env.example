# ── OpenAI / proveedor compatible (deepseek, openrouter, etc.) ─────────────
OPENAI_API_KEY = sk-xxx
OPENAI_BASE_URL = https://api.openai.com/v1
OPENAI_MODEL = gpt-4o-mini

# Color hex (sin #) que prefija los mensajes públicos del bot
TEXT_COLOR = b95dff

# ── Conexión con el chat ───────────────────────────────────────────────────
CHAT_API_URL = http://localhost:3001
# Generar desde el panel Admin → Bots con el username del usuario bot moderador
CHAT_API_KEY = your-moderator-bot-api-key-here

# ── Moderación automática ──────────────────────────────────────────────────
MODERATION_ENABLED = true              # true/false - Activar el LLM de moderación
AUTO_MODERATE_ALL = true               # true/false - Moderar TODOS los mensajes (excepto mods/admins/bots)
AUTO_DELETE_MESSAGES = true            # true/false - Eliminar el mensaje en timeout/ban
SEND_MODERATION_WARNINGS = true        # true/false - Publicar advertencia en el chat (auto-eliminada a los 10s)
PERSONAL_INFO_PROTECTION = true        # true/false - Detectar info personal (teléfonos, emails, redes)

# Severidad: STRICT (modera ante la duda) / MODERATE (default razonable) /
# LENIENT (solo lo abusivo) / PRIVACY_ONLY (solo info personal y spam)
MODERATION_LEVEL = MODERATE
