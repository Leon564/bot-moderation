OPENAI_API_KEY = sk-xxx
OPENAI_BASE_URL = https://api.openai.com/v1
OPENAI_MODEL = gpt-3.5-turbo

TEXT_COLOR = b95dff

# ── Conexión con el chat (E:\Dev\chat\backend) ─────────────────────────────
# URL base del backend del chat (sin barra final)
CHAT_API_URL = http://localhost:3001

# API Key generada desde el panel Admin → Bots para el usuario bot moderador
CHAT_API_KEY = your-api-key-here

# ── Configuración de moderación automática ────────────────────────────────
MODERATION_ENABLED = true              # true/false - Activar moderación con GPT
AUTO_MODERATE_ALL = true               # true/false - Moderar TODOS los mensajes
AUTO_DELETE_MESSAGES = true            # true/false - Eliminar mensajes para timeout/ban
MODERATION_ONLY_MODE = true            # true/false - Solo moderar (legacy flag, sin uso ahora)
SEND_MODERATION_WARNINGS = true        # true/false - Enviar advertencias públicas
PERSONAL_INFO_PROTECTION = true        # true/false - Detectar info personal (teléfonos, redes, emails)

# ── Niveles de moderación ─────────────────────────────────────────────────
MODERATION_LEVEL = STRICT              # STRICT/MODERATE/LENIENT/PRIVACY_ONLY
TOXICITY_THRESHOLD = 0.7               # 0.0-1.0 - Umbral de toxicidad
CONTEXT_AWARENESS = true               # true/false - Considerar contexto y sarcasmo
