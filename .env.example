# ── OpenAI / proveedor compatible (deepseek, openrouter, etc.) ─────────────
OPENAI_API_KEY = sk-xxx
OPENAI_BASE_URL = https://api.openai.com/v1
OPENAI_MODEL = gpt-4o-mini

# Color hex (sin #) que prefija los mensajes públicos del bot
TEXT_COLOR = b95dff

# ── Conexión con el chat ───────────────────────────────────────────────────
CHAT_API_URL = http://localhost:3001
# Generar desde el panel Admin → Bots con el username del usuario bot moderador
CHAT_API_KEY = your-moderator-bot-api-key-here

# ── MongoDB ────────────────────────────────────────────────────────────────
# Misma DB que el chat backend. El moderador usa collections con prefijo mod_*.
MONGODB_URI = mongodb+srv://user:password@cluster.mongodb.net/chatapp?retryWrites=true&w=majority

# ── Moderación automática ──────────────────────────────────────────────────
MODERATION_ENABLED = true              # true/false - Activar el LLM de moderación
AUTO_MODERATE_ALL = true               # true/false - Moderar TODOS los mensajes (excepto mods/admins/bots)
AUTO_DELETE_MESSAGES = true            # true/false - Eliminar el mensaje en timeout/ban
SEND_MODERATION_WARNINGS = true        # true/false - Publicar advertencia en el chat (auto-eliminada a los 10s)
PERSONAL_INFO_PROTECTION = true        # true/false - Detectar info personal (teléfonos, emails, redes)

# Severidad: STRICT (modera ante la duda) / MODERATE (default razonable) /
# LENIENT (solo lo abusivo) / PRIVACY_ONLY (solo info personal y spam)
MODERATION_LEVEL = MODERATE

# ── Sistema de strikes (advertencias acumulativas) ─────────────────────────
# Tras N advertencias de la severidad configurada dentro de la ventana de
# tiempo, el bot dispara un ban temporal. El contador se resetea al banear
# y también si pasa la ventana sin nuevas infracciones.
STRIKES_BEFORE_BAN = 3                 # cantidad de advertencias antes del ban
STRIKE_BAN_DURATION = 1h               # legacy fallback; usado solo si BAN_LADDER queda vacío
STRIKE_WINDOW_HOURS = 24               # ventana en horas para acumular strikes
STRIKE_COUNT_SEVERITY = medium         # medium (spam + graves) / high (solo graves) / all

# Bans escalonados: cada ban consecutivo del mismo user dentro de la ventana
# avanza al siguiente nivel; al agotarse, repite el último.
BAN_LADDER = 5m,1h,1d                  # lista coma-separada (5m/1h/1d/1w/permanent)
BAN_LADDER_WINDOW_DAYS = 30

# Whitelist de usuarios que pasan moderación. Coma-separados, lowercase.
MOD_WHITELIST =

# Cache LRU de decisiones del LLM
LLM_CACHE_TTL_MIN = 5
LLM_CACHE_MAX = 1000

# Reputación implícita
REPUTATION_ENABLED = true
REPUTATION_DAYS = 7
