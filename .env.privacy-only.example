# 🔒 Configuración PRIVACY_ONLY (Solo Redes Sociales)

# API Keys
OPENAI_API_KEY = sk-xxx

# CBox Configuration  
CBOX_URL = https://my.cbox.ws/example
CBOX_USERNAME = example
CBOX_PASSWORD = example
CBOX_DEFAULT_PIC= https://cbox.im/i/mUYUb.jpg

TEXT_COLOR= b95dff

# Configuración básica de moderación
MODERATION_ENABLED = true              # true - Activar moderación (solo para información personal)
AUTO_MODERATE_ALL = true               # true - Moderar TODOS los mensajes 
AUTO_DELETE_MESSAGES = true            # true - Eliminar automáticamente información personal
MODERATION_ONLY_MODE = true            # true - Solo moderar sin chatear
SEND_MODERATION_WARNINGS = true        # true - Enviar advertencias cuando elimine información personal
PERSONAL_INFO_PROTECTION = true        # true - DEBE estar en true para funcionar

# ⭐ MODO SOLO PRIVACIDAD - Solo elimina redes sociales, teléfonos, emails
MODERATION_LEVEL = PRIVACY_ONLY        # PRIVACY_ONLY - Solo modera información personal
TOXICITY_THRESHOLD = 0.0               # 0.0 - No importa en este modo  
CONTEXT_AWARENESS = true               # true - Para detectar spam fragmentado

# ✅ CON ESTA CONFIGURACIÓN:
# - Permite insultos, groserías, lenguaje fuerte
# - Permite contenido sexual, debates acalorados  
# - Permite spam conversacional
# - ELIMINA: números, emails, "@usuario en instagram", etc.
# - ELIMINA: información personal fragmentada en múltiples mensajes